# Platform
CONFIG_MACH_XIAOMI_LMI=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_MI=y
CONFIG_TOUCHSCREEN_FTS_FOD=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_FOD=y

# Power
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_ONEWIRE_GPIO=y

# Vibrator
CONFIG_INPUT_AW8697_HAPTIC=y

# Camera
CONFIG_TECHPACK_CAMERA_XIAOMI=y

# KernelSU-Next: this kernel is non-GKI with no manual hook patches applied
# to core files (fs/exec.c, fs/open.c, etc.), so use the kprobes+tracepoint
# hook mode instead - it needs no source changes outside drivers/kernelsu.
# Kconfig's own defaults would normally pick this once CONFIG_KPROBES=y, but
# olddefconfig resolves KSU_MANUAL_HOOK's "default y if !KPROBES" before
# HAVE_SYSCALL_TRACEPOINTS/KRETPROBES are known true, so force both explicitly.
CONFIG_KPROBES=y
CONFIG_KSU=y
CONFIG_KSU_KPROBES_HOOK=y
# CONFIG_KSU_MANUAL_HOOK is not set

# SUSFS defaults to y (depends on THREAD_INFO_IN_TASK, which this kernel has)
# but needs real kernel-side patches (include/linux/susfs.h, fs/* hooks) that
# have not been ported to sm8250 - out of scope for the plain KSU-Next add.
# CONFIG_KSU_SUSFS is not set
